# ====================================================================
# Ranking Consensus Engine · "Meu gosto vs o Mundo" — Credenciais
#
# Como usar:
#   1) Copie este arquivo para `.env`
#        Windows:  copy .env.example .env
#        macOS:    cp .env.example .env
#   2) Preencha os valores e, no app do Spotify, cadastre a REDIRECT_URI.
#
# IMPORTANTE: NUNCA versione o `.env` — ele contém segredos.
# O `.env` já está no `.gitignore`.
# ====================================================================

# --------------------------------------------------------------------
# Spotify Web API  (fluxo Authorization Code — login do usuário)
# --------------------------------------------------------------------
# 1) Crie um app gratuito em: https://developer.spotify.com/dashboard
# 2) No app (Settings), copie o "Client ID" e o "Client Secret".
# 3) Em "Redirect URI", adicione EXATAMENTE o valor abaixo.
# 4) Cole as credenciais aqui.
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui

# IMPORTANTE neste fluxo (login): a Redirect URI precisa bater EXATAMENTE
# com a cadastrada no app do Spotify.
#
# Dica: se o dashboard recusar "localhost", use "127.0.0.1" (para muitos é
# o que passa na validação). Precisa ser idêntico em: dashboard + aqui + o
# servidor Node (que vai bindar na MESMA porta/host).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Escopos necessários (user-top-read = suas mais tocadas;
# user-read-recently-played = análise por dia, opcional).
SPOTIFY_SCOPES=user-top-read

# --------------------------------------------------------------------
# Deezer  (sem chave — API pública; valores de referência)
# --------------------------------------------------------------------
DEEZER_CHART_URL=https://api.deezer.com/chart/0/tracks

# --------------------------------------------------------------------
# Apple / iTunes RSS  (sem chave — valores de referência)
# --------------------------------------------------------------------
ITUNES_TOP_SONGS_URL=https://itunes.apple.com/us/rss/topsongs/limit=100/json
